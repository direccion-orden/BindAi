{
  "hosting": [
    {
      "target": "main-site",
      "source": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "scratch/**",
        "legacy-worktree/**",
        "hardware-agent/**",
        "scripts/**",
        "*.js",
        "*.json",
        "!package.json",
        "!package-lock.json",
        "!next.config.js",
        "!firestore.indexes.json",
        "*.tsx",
        "*.md",
        "*.xml"
      ],
      "frameworksBackend": {
        "region": "us-central1"
      }
    },
    {
      "target": "staging",
      "source": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "scratch/**",
        "legacy-worktree/**",
        "hardware-agent/**",
        "scripts/**",
        "*.js",
        "*.json",
        "!package.json",
        "!package-lock.json",
        "!next.config.js",
        "!firestore.indexes.json",
        "*.tsx",
        "*.md",
        "*.xml"
      ],
      "frameworksBackend": {
        "region": "us-central1"
      }
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
