rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /anticipos/{allPaths=**} {
      // Misma regla: Solo usuarios de tu dominio pueden ver y subir fotos
      allow read, write: if request.auth != null && request.auth.token.email.matches(".*@ordendelascosas[.]com");
    }
    
    match /products/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email.matches(".*@ordendelascosas[.]com");
    }

    match /companies/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email.matches(".*@ordendelascosas[.]com");
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
